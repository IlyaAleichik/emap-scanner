<Window xmlns="https://github.com/avaloniaui"
        xmlns:converters="using:EMapScannerGui.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EMapScannerGui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EMapScannerGui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EMapScannerGui">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter"/>
        <converters:StatusTextConverter x:Key="StatusTextConverter"/>
        <converters:SelectedProductInfoConverter x:Key="SelectedProductInfoConverter"/>
        <converters:PriceToColorConverter x:Key="PriceToColorConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

        <Grid.Resources>
            <vm:DevicesViewModel x:Key="DeviceVm"/>
            <!--        <local:ProductsViewModel x:Key="ProductsVM"/>
            <local:SettingsViewModel x:Key="SettingsVM"/>-->
        </Grid.Resources>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Управление товарами"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Панель инструментов -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,0,0,10">
            <!-- Поиск -->
            <TextBox Text="{Binding SearchText}"
                     Watermark="Поиск товаров..."
                     Width="200"/>

            <Button Content="Добавить"
                    Command="{Binding AddProductCommand}"
                    Classes="accent"/>

            <Button Content="Редактировать"
                    Command="{Binding EditProductCommand}"/>

            <Button Content="Удалить"
                    Command="{Binding DeleteProductCommand}"/>

            <Button Content="Обновить"
                    Command="{Binding RefreshCommand}"/>

            <Button Content="Сбросить фильтры"
                    Command="{Binding ClearFiltersCommand}"/>

            <Button Content="Экспорт CSV"
                    Command="{Binding ExportToCsvCommand}"/>

            <Button Content="Устройства"
                    Command="{Binding ExportToCsvCommand}"/>
        </StackPanel>


        <!--    <Grid DataContext="{StaticResource DeviceVm}">
        <DataGrid  Margin="20" ItemsSource="{Binding Devices}"
        AutoGenerateColumns="True" IsReadOnly="True"
        GridLinesVisibility="All"
        BorderThickness="1" BorderBrush="Gray">
        </DataGrid>
        </Grid>-->


        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredProducts}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  GridLinesVisibility="All"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Margin="0,0,0,10">

            <DataGrid.Columns>
                <!-- Колонка с чекбоксом -->
                <DataGridCheckBoxColumn Header="Доступен"
                                        Binding="{Binding IsAvailable}"
                                        Width="80"/>

                <!-- Текстовые колонки -->
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Name}"
                                    Width="50"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Наименование"
                                    Binding="{Binding Name}"
                                    Width="200"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category}"
                                    Width="150"/>

                <!-- Колонка с форматированием цены -->
                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price, StringFormat=\{0:F2\} ₽}"
                                    Width="100">

                </DataGridTextColumn>

                <!-- Колонка с числом -->
                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="80"/>

                <!-- Колонка с датой -->
                <DataGridTextColumn Header="Дата добавления"
                                    Binding="{Binding AddedDate, StringFormat=\{0:dd.MM.yyyy\}}"
                                    Width="120"/>

                <!-- Шаблонная колонка для индикации наличия -->
                <!--	<DataGridTemplateColumn Header="Статус" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                <Border CornerRadius="3"
                Background="{Binding IsAvailable, Converter={StaticResource converters:StatusColorConverter}}"
                Padding="5,2"
                HorizontalAlignment="Center">
                <TextBlock Text="{Binding IsAvailable, Converter={StaticResource converters:StatusTextConverter}}"
                Foreground="White"
                FontSize="10"/>
                </Border>
                </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->

                <!-- Шаблонная колонка с кнопками -->

            </DataGrid.Columns>
        </DataGrid>

        <!--<DataGrid Margin="20" ItemsSource="{Binding FilteredProducts}"
        AutoGenerateColumns="True" IsReadOnly="True"
        GridLinesVisibility="All"
        BorderThickness="1" BorderBrush="Gray">
        </DataGrid>-->

        <!-- Статусная строка -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20">
            <TextBlock Text="{Binding FilteredProducts.Count, StringFormat='Записей: {0}'}"/>
            <TextBlock Text="{Binding Products.Count, StringFormat='Всего товаров: {0}'}"/>

            <!--<TextBlock Text="{Binding SelectedItem, Converter={StaticResource converters:SelectedItemInfoConverter}}"
            FontWeight="Bold"/>-->
        </StackPanel>
    </Grid>
</Window>
